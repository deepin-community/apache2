From: lichenggang <lichenggang@uniontech.com>
Date: Mon, 08 Jun 2026 10:58:00 +0800
Subject: Fix build failure on sw64 by adding $(CRYPT_LIBS) to PROGRAM_LDADD

On sw64 architecture, libcrypt.so.1.1 is not available, causing linker
failures for any tool linking against libaprutil-1.so which depends on
crypt_r. Unlike htpasswd and htdbm which explicitly link with $(CRYPT_LIBS),
other tools and the main apache2 binary only use $(PROGRAM_LDADD) which
does not include $(CRYPT_LIBS).

Adding $(CRYPT_LIBS) to PROGRAM_LDADD in both Makefile.in and
support/Makefile.in ensures all binaries explicitly link against libcrypt,
resolving the undefined reference to crypt_r@XCRYPT_2.0 on sw64.

Signed-off-by: lichenggang <lichenggang@uniontech.com>
---
diff --git a/Makefile.in b/Makefile.in
index 11fbb20..9a3d786 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -4,7 +4,7 @@ CLEAN_SUBDIRS = test
 
 PROGRAM_NAME         = $(progname)
 PROGRAM_SOURCES      = modules.c
-PROGRAM_LDADD        = buildmark.o $(HTTPD_LDFLAGS) $(PROGRAM_DEPENDENCIES) $(PCRE_LIBS) $(EXTRA_LIBS) $(AP_LIBS) $(LIBS)
+PROGRAM_LDADD        = buildmark.o $(HTTPD_LDFLAGS) $(PROGRAM_DEPENDENCIES) $(PCRE_LIBS) $(EXTRA_LIBS) $(AP_LIBS) $(LIBS) $(CRYPT_LIBS)
 PROGRAM_PRELINK      = $(COMPILE) -c $(top_srcdir)/server/buildmark.c
 PROGRAM_DEPENDENCIES = \
   server/libmain.la \
diff --git a/support/Makefile.in b/support/Makefile.in
index c7d7687..c1d8809 100644
--- a/support/Makefile.in
+++ b/support/Makefile.in
@@ -7,7 +7,7 @@ bin_PROGRAMS = htpasswd htdigest htdbm ab logresolve httxt2dbm
 sbin_PROGRAMS = htcacheclean rotatelogs $(NONPORTABLE_SUPPORT)
 TARGETS  = $(bin_PROGRAMS) $(sbin_PROGRAMS)
 
-PROGRAM_LDADD        = $(UTIL_LDFLAGS) $(PROGRAM_DEPENDENCIES) $(EXTRA_LIBS) $(AP_LIBS)
+PROGRAM_LDADD        = $(UTIL_LDFLAGS) $(PROGRAM_DEPENDENCIES) $(EXTRA_LIBS) $(AP_LIBS) $(CRYPT_LIBS)
 PROGRAM_DEPENDENCIES = 
 
 include $(top_builddir)/build/rules.mk
